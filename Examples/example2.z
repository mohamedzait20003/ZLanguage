# M2 example — full coverage: functions, parameters, if/else, while,
#              for, switch, comparisons, logical, unary

fn max(a: int, b: int) -> int {
    if (a > b) { return a }
    return b
}

fn min(a: int, b: int) -> int {
    if (a < b) { return a }
    return b
}

fn abs(n: int) -> int {
    if (n < 0) { return -n }
    return n
}

fn factorial(n: int) -> int {
    if (n <= 1) { return 1 }
    return n * factorial(n - 1)
}

fn is_even(n: int) -> int {
    if (n % 2 == 0) { return 1 }
    return 0
}

fn day_name(d: int) -> int {
    switch (d) {
        case 1: { return 10 }
        case 2: { return 20 }
        case 3: { return 30 }
        default: { return 99 }
    }
}

fn main() -> int {
    # --- comparisons ---
    print(3 > 2)     # 1
    print(2 > 3)     # 0
    print(3 >= 3)    # 1
    print(2 <= 1)    # 0
    print(5 == 5)    # 1
    print(5 != 4)    # 1

    # --- logical ---
    print(1 && 1)    # 1
    print(1 && 0)    # 0
    print(0 || 1)    # 1
    print(0 || 0)    # 0

    # --- unary ---
    print(!0)        # 1
    print(!1)        # 0
    print(-7)        # -7

    # --- function calls ---
    print(max(10, 20))    # 20
    print(min(10, 20))    # 10
    print(abs(-42))       # 42
    print(factorial(6))   # 720
    print(is_even(4))     # 1
    print(is_even(7))     # 0

    # --- if / else ---
    let x: int = 15
    if (x > 10) { print(1) } else { print(0) }
    if (x == 99) { print(0) } else { print(1) }

    # --- while ---
    let i: int = 0
    let s: int = 0
    while (i < 5) {
        s = s + i
        i = i + 1
    }
    print(s)    # 10
    print(i)    # 5

    # --- for ---
    let total: int = 0
    for (let k: int = 1; k <= 10; k = k + 1) {
        total = total + k
    }
    print(total)   # 55

    let prod: int = 1
    for (let k: int = 1; k <= 5; k = k + 1) {
        prod = prod * k
    }
    print(prod)    # 120

    # --- switch ---
    print(day_name(1))   # 10
    print(day_name(2))   # 20
    print(day_name(3))   # 30
    print(day_name(9))   # 99

    let val: int = 2
    switch (val) {
        case 1: { print(100) }
        case 2: { print(200) }
        case 3: { print(300) }
        default: { print(0) }
    }

    # --- nested for + if ---
    let evens: int = 0
    for (let n: int = 1; n <= 20; n = n + 1) {
        if (is_even(n) == 1) {
            evens = evens + 1
        }
    }
    print(evens)   # 10

    # --- compound conditions ---
    let a: int = 4
    let b: int = 7
    if (a > 0 && b > 0) { print(1) }
    if (a > 10 || b > 5) { print(1) }

    return 0
}

fn main_do() -> int {
    # --- do ... along ---
    let n: int = 1
    let result: int = 0
    do {
        result = result + n
        n = n + 1
    } along (n <= 5)
    print(result)   # 1+2+3+4+5 = 15

    let x: int = 10
    do {
        print(x)    # 10  (runs once even though condition is false immediately after)
        x = x - 1
    } along (x > 10)

    return 0
}
