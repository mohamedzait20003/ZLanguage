# Ternary sits between `||` and assignment, and is right-associative.
# static_cast is the only way to narrow or convert across kinds.

fn max3(a: int, b: int, c: int) -> int {
    let m: int = a > b ? a : b
    return m > c ? m : c
}

fn main() -> int {
    let a: int = 5
    let b: int = 9

    print(a > b ? a : b)        # 9
    print(a < b ? a : b)        # 5
    print(max3(3, 9, 6))        # 9

    # right-associative chaining
    print(a > 8 ? 1 : a > 4 ? 2 : 3)    # 2

    # lower precedence than ||, so the disjunction is the condition
    print(a > 100 || b > 8 ? 10 : 20)   # 10

    # branches unify to a common numeric type
    let mixed: double = a > 0 ? 1 : 2.5
    print(mixed)                # 1.000000

    # reference-typed branches
    let s: string = a > 0 ? "yes" : "no"
    print(s)

    # a null branch takes the other branch's type
    let maybe: string = a > 100 ? "unreachable" : null
    print(maybe == null)        # 1

    # --- static_cast ---
    print(static_cast<int>(3.99))         # 3, truncation not rounding
    print(static_cast<int>(-3.99))        # -3
    print(static_cast<double>(7))         # 7.000000
    print(static_cast<int32>(70000))      # 70000
    print(static_cast<character>(65))     # A
    print(static_cast<int>('A'))          # 65
    print(static_cast<float16>(1.5))      # 1.500000
    print(static_cast<bool>(0))           # 0
    print(static_cast<bool>(5))           # 1

    return 0
}
